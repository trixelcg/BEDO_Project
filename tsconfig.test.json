{
  // The test suite, typechecked separately from the app build.
  //
  // Kept out of tsconfig.json's references on purpose: `npm run build` must keep doing
  // exactly what it did before BEDO-002, so a change in a spec can never break a
  // production build. `npm run typecheck` runs both projects.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
    `src/vite-env.d.ts` is included for the build-time constants it declares globally.
    The specs render real components, and a component that reads `__APP_VERSION__` is
    checked here as well as by `tsconfig.app.json` — without it this project alone would
    report the constant as undefined.
  */
  "include": [
    "tests",
    "src/vite-env.d.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
